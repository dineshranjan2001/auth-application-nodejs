{
  "name": "auth-project",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:init": "npx prisma init --datasource-provider postgresql --output ../generated/prisma",
    "db:reset": "npx prisma migrate reset",
    "db:generate":"npx prisma generate",
    "db:sync": "node -e \"const { execSync } = require('child_process'); const name = process.argv[1] || ''; execSync('npx prisma migrate dev ' + (name ? '--name ' + JSON.stringify(name) : '') + ' && npx prisma generate', { stdio: 'inherit' });\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "Dinesh Ranjan Biswal",
  "license": "ISC",
  "description": "This is an Authentication basis project.",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1"
  }
}
